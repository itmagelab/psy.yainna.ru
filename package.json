{
  "name": "psy-yainna-ru",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Лендинг психотерапевта в гештальт-подходе",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/og.mjs && astro build && node scripts/preload-fonts.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:watch": "astro check --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
