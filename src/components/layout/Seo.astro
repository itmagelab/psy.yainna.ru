---
import { site } from '../../data/site';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Граф Schema.org для страницы. */
  jsonLd?: object;
  /** Скрывает содержимое main от скринридера (для 404). */
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;

/**
 * Файлы из `public/` лежат в корне сайта, но при публикации на подпути
 * (GitHub Pages отдаёт проект по /psy.yainna.ru) к ним нужен префикс.
 * BASE_URL Astro уже учитывает base и завершающий слеш.
 */
const base = import.meta.env.BASE_URL;
const asset = (path: string) => new URL(path.replace(/^\//, ''), new URL(base, Astro.site)).href;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = asset(site.seo.ogImage);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta name="author" content={site.fullName} />
<meta name="geo.region" content="RU-23" />
<meta name="geo.placename" content={site.city} />
<meta name="theme-color" content="#f8f4ee" media="(prefers-color-scheme: light)" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.role} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.fullName} — ${site.role}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
<link rel="manifest" href={asset('/site.webmanifest')} />
<link rel="sitemap" href={asset('/sitemap-index.xml')} />

{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
