---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import type { z } from 'astro/zod';
import type { sectionSchema } from '../../schemas/sections';

type Data = Extract<z.infer<typeof sectionSchema>, { kind: 'process' }>;

interface Props {
  data: Data;
}

const { data } = Astro.props;
const titleId = 'process-title';
---

<section id={data.anchor} class="section bg-clay-100" aria-labelledby={titleId}>
  <div class="page">
    <Reveal>
      <SectionHeader
        eyebrow={data.eyebrow}
        title={data.title}
        intro={data.intro}
        id={titleId}
        class="max-w-[46rem]"
      />
    </Reveal>

    <ol class="mt-14 grid gap-8 md:grid-cols-3 md:gap-10">
      {data.steps.map((step, index) => (
        <Reveal as="li" class="relative" delay={index * 90}>
          <div class="flex items-center gap-4">
            <span
              class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-ink-900/15 bg-cream-50 font-display text-h4 text-clay-600"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <span class="h-px flex-1 bg-ink-900/12" aria-hidden="true" />
          </div>
          <h3 class="mt-6 font-display text-h3 text-ink-900">{step.title}</h3>
          <p class="mt-3 text-small text-pretty text-ink-700">{step.text}</p>
        </Reveal>
      ))}
    </ol>

    {data.highlights.length > 0 && (
      <Reveal class="mt-14" delay={120}>
        <dl class="grid gap-px overflow-hidden rounded-lg border border-ink-900/10 bg-ink-900/10 sm:grid-cols-3">
          {data.highlights.map((item) => (
            <div class="bg-cream-50 px-6 py-7">
              <dt class="text-tiny tracking-[0.14em] text-ink-500 uppercase">{item.label}</dt>
              <dd class="mt-2 font-display text-h3 text-ink-900">{item.value}</dd>
            </div>
          ))}
        </dl>
      </Reveal>
    )}

    {data.note && <p class="mt-8 max-w-[58ch] text-small text-ink-700">{data.note}</p>}
  </div>
</section>
