---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import Lightbox from '../ui/Lightbox.astro';
import { getPhoto } from '../../lib/photos';
import type { z } from 'astro/zod';
import type { sectionSchema } from '../../schemas/sections';

type Data = Extract<z.infer<typeof sectionSchema>, { kind: 'education' }>;

interface Props {
  data: Data;
}

const { data } = Astro.props;
const titleId = 'education-title';

const items = data.items.map((item) => ({
  ...item,
  image: item.certificate ? getPhoto(item.certificate.src) : undefined,
}));
---

<section id={data.anchor} class="section border-t border-cream-300" aria-labelledby={titleId}>
  <div class="page">
    <Reveal>
      <SectionHeader
        eyebrow={data.eyebrow}
        title={data.title}
        intro={data.intro}
        id={titleId}
        class="max-w-[46rem]"
      />
    </Reveal>

    <ol class="mt-14 space-y-0">
      {items.map((item, index) => (
        <Reveal
          as="li"
          class="group relative grid gap-2 border-t border-cream-300 py-7 sm:grid-cols-[7rem_1fr] sm:gap-8 last:border-b"
          delay={index * 60}
        >
          <div class="flex items-baseline gap-4 sm:block">
            {item.year && (
              <span class="font-display text-h4 tabular-nums whitespace-nowrap text-clay-600">
                {item.year}
              </span>
            )}
            <span
              class="mt-1 hidden h-1.5 w-1.5 rounded-full bg-clay-500 transition-transform duration-500 ease-soft group-hover:scale-150 sm:block"
              aria-hidden="true"
            />
          </div>

          <div>
            <h3 class="font-display text-h4 text-balance text-ink-900">{item.title}</h3>
            {item.place && <p class="mt-1.5 text-small text-ink-500">{item.place}</p>}
            {item.note && <p class="mt-3 max-w-[54ch] text-small text-ink-500">{item.note}</p>}

            {item.image && (
              <button
                type="button"
                class="mt-4 flex items-center gap-3 text-small text-ink-700 transition-colors hover:text-clay-700"
                data-lightbox-open
                data-lightbox-src={item.image.src}
                data-lightbox-alt={item.certificate?.alt}
                data-lightbox-width={item.image.width}
                data-lightbox-height={item.image.height}
              >
                <span class="h-9 w-9 overflow-hidden rounded-xs border border-cream-300 bg-cream-200">
                  <img
                    src={item.image.src}
                    alt=""
                    width={item.image.width}
                    height={item.image.height}
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                Посмотреть документ
              </button>
            )}
          </div>
        </Reveal>
      ))}
    </ol>

    {data.note && <p class="mt-8 max-w-[54ch] text-small text-ink-500">{data.note}</p>}

    <Lightbox />
  </div>
</section>
