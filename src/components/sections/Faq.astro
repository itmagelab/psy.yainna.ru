---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import type { z } from 'astro/zod';
import type { sectionSchema } from '../../schemas/sections';

type Data = Extract<z.infer<typeof sectionSchema>, { kind: 'faq' }>;

interface Props {
  data: Data;
}

const { data } = Astro.props;
const titleId = 'faq-title';
const baseId = Astro.url.pathname.replace(/\W/g, '-');
---

<section id={data.anchor} class="section bg-mist-100" aria-labelledby={titleId}>
  <div class="page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <Reveal class="lg:col-span-4" as="div">
        <SectionHeader eyebrow={data.eyebrow} title={data.title} intro={data.intro} id={titleId} />
        <a class="link-soft mt-6 inline-block text-small" href="#contact">
          Остался вопрос? Напишите мне
        </a>
      </Reveal>

      <Reveal class="lg:col-span-8" delay={80} as="div">
        <!--
          Аккордеон по WAI-ARIA APG: кнопка + aria-expanded + aria-controls,
          панели с role="region". Без JS панели раскрыты (атрибут open
          снимается скриптом), то есть весь текст доступен и для поиска,
          и без JavaScript.
        -->
        <ul class="divide-y divide-cream-300 border-y border-cream-300" data-accordion>
          {data.items.map((item, index) => {
            const panelId = `${baseId}-faq-panel-${index}`;
            const buttonId = `${baseId}-faq-button-${index}`;
            return (
              <li data-accordion-item data-open={index === 0 ? '' : undefined}>
                <h3>
                  <button
                    type="button"
                    class="group flex w-full items-start justify-between gap-6 py-6 text-left"
                    id={buttonId}
                    aria-expanded={index === 0 ? 'true' : 'false'}
                    aria-controls={panelId}
                    data-accordion-button
                  >
                    <span
                      class="font-display text-h4 text-balance text-ink-900 transition-colors group-hover:text-clay-700"
                      data-accordion-label
                    >
                      {item.q}
                    </span>
                    <span
                      class="relative mt-1.5 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink-900/15 text-ink-700"
                      aria-hidden="true"
                    >
                      <span class="absolute h-px w-3 bg-current"></span>
                      <span
                        class="absolute h-3 w-px bg-current transition-transform duration-500 ease-soft"
                        data-accordion-plus
                      ></span>
                    </span>
                  </button>
                </h3>
                <div
                  id={panelId}
                  role="region"
                  aria-labelledby={buttonId}
                  class="grid transition-[grid-template-rows] duration-500 ease-soft"
                  data-accordion-panel
                  style="grid-template-rows: 1fr"
                >
                  <div class="overflow-hidden">
                    <p class="max-w-[62ch] pb-7 text-pretty text-ink-700">{item.a}</p>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </Reveal>
    </div>
  </div>
</section>

<script>
  import { initAccordion } from '../../scripts/accordion';

  initAccordion();
</script>
