---
import SectionHeader from '../ui/SectionHeader.astro';
import Reveal from '../ui/Reveal.astro';
import Check from '../ui/Check.astro';
import { formatPrice } from '../../lib/format';
import type { z } from 'astro/zod';
import type { sectionSchema } from '../../schemas/sections';

type Data = Extract<z.infer<typeof sectionSchema>, { kind: 'pricing' }>;

interface Props {
  data: Data;
}

const { data } = Astro.props;
const titleId = 'pricing-title';
---

<section id={data.anchor} class="section border-t border-cream-300" aria-labelledby={titleId}>
  <div class="page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <Reveal class="lg:col-span-5" as="div">
        <SectionHeader eyebrow={data.eyebrow} title={data.title} intro={data.intro} id={titleId} />
        {data.note && <p class="mt-6 max-w-[46ch] text-small text-ink-500">{data.note}</p>}
      </Reveal>

      <div class="lg:col-span-7">
        {data.offers.map((offer, index) => (
          <Reveal
            class="rounded-xl border border-ink-900/10 bg-cream-50 p-7 shadow-soft sm:p-10"
            delay={index * 80}
          >
            <div class="flex flex-wrap items-start justify-between gap-6">
              <div>
                <h3 class="font-display text-h3 text-ink-900">{offer.name}</h3>
                {offer.format && <p class="mt-2 text-small text-ink-500">{offer.format}</p>}
              </div>

              <div class="text-right">
                <p class="font-display text-h2 text-clay-600">{formatPrice(offer.price)}</p>
                {offer.priceNote && <p class="mt-1 text-tiny text-ink-500">{offer.priceNote}</p>}
              </div>
            </div>

            <dl class="mt-8 grid gap-x-8 gap-y-4 border-t border-cream-300 pt-8 sm:grid-cols-2">
              <div>
                <dt class="text-tiny tracking-[0.14em] text-ink-500 uppercase">Длительность</dt>
                <dd class="mt-1 text-small text-ink-900">{offer.duration}</dd>
              </div>
              <div>
                <dt class="text-tiny tracking-[0.14em] text-ink-500 uppercase">Регулярность</dt>
                <dd class="mt-1 text-small text-ink-900">{offer.frequency}</dd>
              </div>
              {offer.address && (
                <div class="sm:col-span-2">
                  <dt class="text-tiny tracking-[0.14em] text-ink-500 uppercase">Очный приём</dt>
                  <dd class="mt-1 text-small text-ink-900">{offer.address}</dd>
                </div>
              )}
            </dl>

            {data.includes.length > 0 && (
              <ul class="mt-8 grid gap-3 sm:grid-cols-2">
                {data.includes.map((item) => (
                  <li class="flex items-start gap-3 text-small text-ink-700">
                    <span class="mt-0.5 text-clay-500" aria-hidden="true">
                      <Check />
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}

            <a class="btn btn--clay mt-9" href="#contact">
              Записаться на первую встречу
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </div>
</section>
