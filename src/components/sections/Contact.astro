---
import Reveal from '../ui/Reveal.astro';
import Icon from '../ui/Icon.astro';
import { messengerLinks } from '../../lib/links';
import { internalHref } from '../../lib/base';
import type { z } from 'astro/zod';
import type { sectionSchema } from '../../schemas/sections';

type Data = Extract<z.infer<typeof sectionSchema>, { kind: 'contact' }>;

interface Props {
  data: Data;
}

const { data } = Astro.props;
const titleId = 'contact-title';

const defaultMethod = data.methods[0]?.network ?? 'telegram';
---

<section id={data.anchor} class="section bg-ink-900 text-cream-100" aria-labelledby={titleId}>
  <div class="page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <Reveal class="lg:col-span-5" as="div">
        <p class="eyebrow text-clay-300">{data.eyebrow}</p>
        <h2 id={titleId} class="mt-5 text-h2 text-cream-50">
          {data.title}
        </h2>
        <p class="mt-5 max-w-[44ch] text-lead text-pretty text-cream-200/80">{data.intro}</p>

        <p class="mt-8 flex items-start gap-3 border-t border-cream-100/15 pt-8 text-small text-cream-200/80">
          <span class="mt-0.5 text-clay-300" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" focusable="false">
              <path
                d="M10 2.5v1.2m0 12.6v1.2M3.4 3.4l.9.9m11.4 11.4.9.9M2.5 10h1.2m12.6 0h1.2"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
              ></path>
              <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.4"></circle>
            </svg>
          </span>
          <span>{data.promise}</span>
        </p>

        <ul class="mt-10 space-y-3" data-direct-links>
          {data.methods.map((method) => (
            <li>
              <a
                class="group flex items-center gap-4 rounded-lg border border-cream-100/15 px-5 py-4 transition-colors duration-500 ease-soft hover:border-clay-300/50 hover:bg-cream-100/5"
                href={messengerLinks[method.network]()}
                rel="noopener"
              >
                <span class="text-clay-300" aria-hidden="true">
                  <Icon name={method.network} size={20} />
                </span>
                <span class="flex-1">
                  <span class="block text-small text-cream-50">{method.label}</span>
                  {method.note && (
                    <span class="mt-0.5 block text-tiny text-cream-200/60">{method.note}</span>
                  )}
                </span>
                <svg
                  viewBox="0 0 20 20"
                  width="18"
                  height="18"
                  fill="none"
                  class="text-cream-200/40 transition-transform duration-500 ease-soft group-hover:translate-x-1"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M4 10h11m0 0-4-4m4 4-4 4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>
                </svg>
              </a>
            </li>
          ))}
        </ul>

        {data.fallbackNote && <p class="mt-5 text-tiny text-cream-200/60">{data.fallbackNote}</p>}
      </Reveal>

      <Reveal class="lg:col-span-7" delay={90} as="div">
        <!--
          Форма ничего не отправляет на сервер: она собирает текст и открывает
          выбранный мессенджер. Без JS форма скрыта (data-js-only), и остаются
          рабочие прямые ссылки выше.
        -->
        <form
          class="rounded-xl bg-cream-50 p-7 text-ink-900 shadow-ink sm:p-9"
          data-contact-form
          data-default-method={defaultMethod}
          data-message-template={data.messageTemplate}
          data-js-only
          novalidate
        >
          <fieldset>
            <legend class="text-tiny tracking-[0.14em] text-ink-500 uppercase">
              Куда написать
            </legend>
            <div class="mt-3 flex flex-wrap gap-2">
              {data.methods.map((method, index) => (
                <label class="cursor-pointer rounded-full border border-ink-900/12 px-4 py-2 text-small text-ink-700 transition-colors duration-300 ease-soft has-checked:border-ink-900 has-checked:bg-ink-900 has-checked:text-cream-50 hover:border-ink-900/30">
                  <input
                    type="radio"
                    name="method"
                    value={method.network}
                    class="sr-only"
                    checked={index === 0}
                    data-method-input
                  />
                  <span class="flex items-center gap-2">
                    <Icon name={method.network} size={16} />
                    {method.label}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="mt-7 grid gap-5 sm:grid-cols-2">
            <div class="sm:col-span-1">
              <label class="text-small text-ink-700" for="contact-name">
                Как вас зовут
              </label>
              <input
                class="mt-2 w-full rounded-md border border-ink-900/15 bg-cream-100 px-4 py-3 text-small transition-colors duration-300 placeholder:text-ink-500 focus:border-ink-900 focus:outline-none"
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Имя"
                maxlength="80"
                required
              />
            </div>

            <div class="sm:col-span-1">
              <label class="text-small text-ink-700" for="contact-where">
                Как с вами связаться
              </label>
              <input
                class="mt-2 w-full rounded-md border border-ink-900/15 bg-cream-100 px-4 py-3 text-small transition-colors duration-300 placeholder:text-ink-500 focus:border-ink-900 focus:outline-none"
                id="contact-where"
                name="contact"
                type="text"
                placeholder="Телефон, @username или почта"
                maxlength="120"
                required
              />
            </div>

            <div class="sm:col-span-2">
              <label class="text-small text-ink-700" for="contact-message">
                Что привело <span class="text-ink-500">(необязательно)</span>
              </label>
              <textarea
                class="mt-2 min-h-28 w-full resize-y rounded-md border border-ink-900/15 bg-cream-100 px-4 py-3 text-small leading-relaxed transition-colors duration-300 placeholder:text-ink-500 focus:border-ink-900 focus:outline-none"
                id="contact-message"
                name="message"
                rows="3"
                placeholder="Несколько слов о ситуации — этого достаточно"
                maxlength="1200"
              ></textarea>
            </div>
          </div>

          <label class="mt-6 flex cursor-pointer items-start gap-3 text-small leading-relaxed text-ink-500">
            <input
              class="mt-1 h-4 w-4 shrink-0 accent-clay-700"
              type="checkbox"
              name="consent"
              required
            />
            <span>
              {data.consent.text}
              {data.consent.links.map((link, index) => (
                <>
                  {index > 0 && ' '}
                  <a
                    class="text-ink-900 underline decoration-clay-300 decoration-1 underline-offset-4 transition-colors hover:decoration-clay-600"
                    href={internalHref(link.href)}
                    target="_blank"
                    rel="noopener"
                  >
                    {link.label}
                  </a>
                </>
              ))}
            </span>
          </label>

          <button class="btn btn--clay btn--block mt-7" type="submit" data-submit>
            <span data-submit-label>Отправить</span>
          </button>

          <p
            class="mt-4 min-h-5 text-tiny text-ink-500"
            role="status"
            aria-live="polite"
            data-status
          ></p>
        </form>
      </Reveal>
    </div>
  </div>
</section>

<script>
  import { initContactForm } from '../../scripts/contact-form';

  initContactForm();
</script>
