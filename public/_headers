/*
 * GitHub Pages: заголовки безопасности и кеширование.
 * Файл поддерживается только при сборке через Actions (build_type: workflow),
 * при выборе ветки как источника он игнорируется.
 */

/* Ассеты сборки содержат хэш в имени — их можно кешировать надолго. */
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800

/*
  Content-Security-Policy: скрипты и стили инлайнятся Astro (минифицированные,
  в _astro/*.js и инлайн), поэтому в script-src нужен 'unsafe-inline'.
 * Внешние домены не используются: шрифты, стили и картинки — свои.
  'unsafe-eval' не требуется.
*/
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
X-Frame-Options: DENY
Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
Strict-Transport-Security: max-age=31536000; includeSubDomains

/*
 * Для всех страниц по умолчанию: revalidate + обязательный HTTPS.
 */
/*
  Cache-Control: public, max-age=0, must-revalidate
*/
